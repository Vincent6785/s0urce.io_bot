root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{js,json,yml,yaml,sh}]
indent_size = 2

# The userscript predates the rest and is 4-space throughout.
[s0urce-autohack.user.js]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
